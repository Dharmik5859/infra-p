{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthwork.local/schemas/cross-sections.schema.json",
  "title": "Cross-section response",
  "description": "GET /api/jobs/{id}/cross-sections",
  "type": "object",
  "required": [
    "document",
    "units",
    "passScore",
    "summary",
    "calibrations",
    "crossSections",
    "shapes",
    "alerts"
  ],
  "properties": {
    "document": {
      "type": "object",
      "required": [
        "fileName",
        "pages",
        "sections",
        "surface"
      ]
    },
    "units": {
      "type": "object",
      "required": [
        "area",
        "volume",
        "pixel"
      ]
    },
    "passScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "object",
      "required": [
        "crossSections",
        "passed",
        "alerts"
      ],
      "properties": {
        "crossSections": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "alerts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "calibrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calibration"
      }
    },
    "crossSections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossSection"
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shape"
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "crossSectionId",
          "pageNumber",
          "stationId",
          "score",
          "level",
          "message",
          "reasons"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "calibration": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "pageNumber",
        "pixelLengthX",
        "pixelLengthY",
        "realWorldLengthX",
        "realWorldLengthY",
        "scaleX",
        "scaleY",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "single"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "pixelLengthX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixelLengthY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "realWorldLengthX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "realWorldLengthY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaleX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "feet per pixel"
        },
        "scaleY": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "feet per pixel"
        },
        "unit": {
          "const": "feet"
        },
        "pixelsPerFootX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixelsPerFootY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "verticalDiffers": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "grid",
            "sheet_note",
            "document_note"
          ]
        },
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "gridScale": {
          "type": "object",
          "required": [
            "ftPerSquareX",
            "ftPerSquareY",
            "sourceX",
            "sourceY"
          ],
          "properties": {
            "ftPerSquareX": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ftPerSquareY": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sourceX": {
              "enum": [
                "labels",
                "ocr",
                "assumed"
              ]
            },
            "sourceY": {
              "enum": [
                "labels",
                "ocr",
                "assumed"
              ]
            }
          },
          "additionalProperties": false
        },
        "noteCheck": {
          "type": "object",
          "required": [
            "text",
            "pixelLengthX",
            "pixelLengthY"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "pixelLengthX": {
              "type": "number"
            },
            "pixelLengthY": {
              "type": "number"
            },
            "printRatio": {
              "type": "number"
            }
          }
        },
        "note": {
          "type": "string"
        },
        "notePage": {
          "type": "integer",
          "minimum": 1
        },
        "printRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "print ratio applied to a note-only sheet (see printScale)"
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "required": [
        "crossSectionType",
        "id",
        "pageNumber",
        "points",
        "position2D",
        "side",
        "stage",
        "stationId",
        "streetName"
      ],
      "properties": {
        "crossSectionType": {
          "enum": [
            "cut",
            "fill"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^polygon-[0-9]+-[a-z0-9_-]+$"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 6,
          "description": "flat [x0, y0, x1, y1, ...] offsets from position2D (a polygon: 3 vertices or more, an even count)"
        },
        "position2D": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "type": "object",
          "required": [
            "width",
            "height",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "depth": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "side": {
          "enum": [
            "left",
            "right",
            null
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\+[0-9]{2}(\\.[0-9]+)?$"
        },
        "streetName": {
          "type": [
            "string",
            "null"
          ]
        },
        "areaSqFt": {
          "type": "number",
          "minimum": 0
        },
        "crossSectionId": {
          "type": "string",
          "pattern": "^xs-[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "crossSection": {
      "type": "object",
      "required": [
        "id",
        "pageNumber",
        "stationId",
        "streetName",
        "stage",
        "areas",
        "confidence",
        "alerts",
        "shapes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^xs-[0-9]+$"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "stationFt": {
          "type": [
            "number",
            "null"
          ]
        },
        "stationSource": {
          "enum": [
            "text",
            "ocr",
            "inferred",
            null
          ]
        },
        "streetName": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibrationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "areas": {
          "$ref": "#/$defs/areas"
        },
        "measuredAreas": {
          "$ref": "#/$defs/areas"
        },
        "edited": {
          "type": "boolean"
        },
        "centreline": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "text",
                "scan",
                "neighbour",
                "assumed",
                null
              ]
            }
          }
        },
        "scale": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "ftPerSquareX",
            "ftPerSquareY",
            "pixelsPerFootX",
            "pixelsPerFootY",
            "sourceX",
            "sourceY"
          ]
        },
        "noEarthwork": {
          "enum": [
            "structure",
            "no_design",
            "matches_existing",
            null
          ]
        },
        "confidence": {
          "type": "object",
          "required": [
            "score",
            "passed",
            "threshold",
            "deductions"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "passed": {
              "type": "boolean"
            },
            "threshold": {
              "type": "number"
            },
            "deductions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/deduction"
              }
            }
          },
          "additionalProperties": false
        },
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alert"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "alerts": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "alerts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "areas": {
      "type": "object",
      "required": [
        "left",
        "right",
        "total"
      ],
      "properties": {
        "left": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "cutSqFt",
            "fillSqFt"
          ],
          "properties": {
            "cutSqFt": {
              "type": "number",
              "minimum": 0
            },
            "fillSqFt": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "right": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "cutSqFt",
            "fillSqFt"
          ],
          "properties": {
            "cutSqFt": {
              "type": "number",
              "minimum": 0
            },
            "fillSqFt": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "total": {
          "type": "object",
          "required": [
            "cutSqFt",
            "fillSqFt",
            "netSqFt"
          ],
          "properties": {
            "cutSqFt": {
              "type": "number",
              "minimum": 0
            },
            "fillSqFt": {
              "type": "number",
              "minimum": 0
            },
            "netSqFt": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "alert": {
      "type": "object",
      "required": [
        "level",
        "message",
        "reasons"
      ],
      "properties": {
        "level": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "deduction": {
      "type": "object",
      "required": [
        "factor",
        "points",
        "note"
      ],
      "properties": {
        "factor": {
          "type": "string"
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
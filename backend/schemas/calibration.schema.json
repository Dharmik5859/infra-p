{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthwork.local/schemas/calibration.schema.json",
  "title": "Calibration response",
  "description": "GET /api/jobs/{id}/calibration",
  "type": "object",
  "required": [
    "document",
    "pixelUnit",
    "documentScale",
    "calibrations",
    "uncalibratedPages",
    "shapes",
    "printScale"
  ],
  "properties": {
    "document": {
      "type": "object",
      "required": [
        "fileName",
        "pages",
        "crossSectionPages",
        "sections",
        "surface"
      ]
    },
    "pixelUnit": {
      "type": "string"
    },
    "documentScale": {
      "type": [
        "object",
        "null"
      ]
    },
    "calibrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calibration"
      }
    },
    "uncalibratedPages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shape"
      }
    },
    "printScale": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "ratio",
        "pages",
        "meaning"
      ],
      "properties": {
        "ratio": {
          "type": "number"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "meaning": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "calibration": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "pageNumber",
        "pixelLengthX",
        "pixelLengthY",
        "realWorldLengthX",
        "realWorldLengthY",
        "scaleX",
        "scaleY",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "single"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "pixelLengthX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixelLengthY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "realWorldLengthX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "realWorldLengthY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaleX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "feet per pixel"
        },
        "scaleY": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "feet per pixel"
        },
        "unit": {
          "const": "feet"
        },
        "pixelsPerFootX": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixelsPerFootY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "verticalDiffers": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "grid",
            "sheet_note",
            "document_note"
          ]
        },
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "gridScale": {
          "type": "object",
          "required": [
            "ftPerSquareX",
            "ftPerSquareY",
            "sourceX",
            "sourceY"
          ],
          "properties": {
            "ftPerSquareX": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ftPerSquareY": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sourceX": {
              "enum": [
                "labels",
                "ocr",
                "assumed"
              ]
            },
            "sourceY": {
              "enum": [
                "labels",
                "ocr",
                "assumed"
              ]
            }
          },
          "additionalProperties": false
        },
        "noteCheck": {
          "type": "object",
          "required": [
            "text",
            "pixelLengthX",
            "pixelLengthY"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "pixelLengthX": {
              "type": "number"
            },
            "pixelLengthY": {
              "type": "number"
            },
            "printRatio": {
              "type": "number"
            }
          }
        },
        "note": {
          "type": "string"
        },
        "notePage": {
          "type": "integer",
          "minimum": 1
        },
        "printRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "print ratio applied to a note-only sheet (see printScale)"
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "required": [
        "crossSectionType",
        "id",
        "pageNumber",
        "points",
        "position2D",
        "side",
        "stage",
        "stationId",
        "streetName"
      ],
      "properties": {
        "crossSectionType": {
          "enum": [
            "cut",
            "fill"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^polygon-[0-9]+-[a-z0-9_-]+$"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 6,
          "description": "flat [x0, y0, x1, y1, ...] offsets from position2D (a polygon: 3 vertices or more, an even count)"
        },
        "position2D": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "type": "object",
          "required": [
            "width",
            "height",
            "depth"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "depth": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "side": {
          "enum": [
            "left",
            "right",
            null
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\+[0-9]{2}(\\.[0-9]+)?$"
        },
        "streetName": {
          "type": [
            "string",
            "null"
          ]
        },
        "areaSqFt": {
          "type": "number",
          "minimum": 0
        },
        "crossSectionId": {
          "type": "string",
          "pattern": "^xs-[0-9]+$"
        }
      },
      "additionalProperties": false
    }
  }
}